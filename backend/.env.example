# Copy to backend/.env and fill in what you have. Anything left blank is skipped.
# This file is read by the backend only; never commit backend/.env.

# --- Claude (chat agent, handwriting transcription) ---
# Chat can run on your Claude subscription instead of an API key: log in to Claude Code
# (`claude auth login`) and leave the key empty. Usage counts against your plan's limits.
# STUDYHUB_AGENT=auto   (auto: the key when set, else the subscription | api | subscription)
ANTHROPIC_API_KEY=
# STUDYHUB_MODEL=claude-opus-5

# --- Canvas: Account -> Settings -> "+ New access token" (give it an expiry date) ---
CANVAS_BASE_URL=https://canvas.stanford.edu
CANVAS_TOKEN=

# --- Gradescope: email + a Gradescope password.
# Stanford SSO accounts: set a password with "Forgot password" on gradescope.com first.
GRADESCOPE_EMAIL=
GRADESCOPE_PASSWORD=

# --- GoodNotes: the local folder that GoodNotes Auto Backup writes PDFs into,
# e.g. the Google Drive for Desktop copy of the backup folder. Put each class's
# notebooks in a folder named after the course code ("CS 231N").
GOODNOTES_DIR=

# --- Granola: Settings -> Connectors -> API keys (Business plan). Put each
# class's lectures in a Granola folder named after the course code.
GRANOLA_API_KEY=

# --- Course websites: many CS courses post slides on their own site, not Canvas.
# List the page that links the slides (usually the schedule), separated by semicolons:
# COURSE_SITES=CS 231N=https://cs231n.stanford.edu/schedule.html; MATH 51=https://example.edu/math51
COURSE_SITES=

# --- Semantic search (optional): finds material phrased differently from your question.
# voyage: set VOYAGE_API_KEY (dash.voyageai.com; 200M free tokens per account). Course text
#         is sent to Voyage to be embedded.
# local:  `pip install -e ".[local-embeddings]"`; a small model runs on this machine instead.
# auto (default) picks voyage if a key is set, else local if installed, else keyword search only.
STUDYHUB_EMBEDDINGS=auto
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4

# --- General ---
# While `studyhub serve` runs, sync Canvas and Granola every 30 min, GoodNotes every 10,
# Gradescope twice a day, course websites every 6 hours. Set to false to sync only on demand.
STUDYHUB_AUTO_SYNC=true
# Time zone used to turn timestamps into lecture dates.
STUDYHUB_TIMEZONE=America/Los_Angeles
# Where the database and downloaded files live (default: ../data from backend/).
# STUDYHUB_DATA_DIR=
